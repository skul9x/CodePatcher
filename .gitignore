# .gitignore

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class

# --- Virtual Environments (Môi trường ảo) ---
# Tên phổ biến cho thư mục venv
venv/
env/
.venv/
.env

# --- PyInstaller (Đóng gói exe) ---
# Được sinh ra khi chạy lệnh trong file donggoi.txt
build/
dist/
*.spec

# --- Project Specific (Cấu hình riêng của CodePatcher) ---
# Thư mục chứa các bản backup/rollback (được định nghĩa trong app/constants.py)
.patch_backups/

# --- IDE Settings (Cấu hình trình soạn thảo) ---
.vscode/
.idea/
*.swp
*.swo

# --- OS Generated Files (File hệ thống) ---
.DS_Store
Thumbs.db
ehthumbs.db

# --- Logs & Databases ---
*.log
*.sqlite3
__pycache__
*.pyc
*.pyo
*.pyd
.venv
venv
env
build
dist
